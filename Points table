<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editable Cricket League Points Table</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f7f9fc;
      margin: 40px;
    }
    h1 {
      text-align: center;
      color: #333;
    }
    table {
      width: 90%;
      margin: 20px auto;
      border-collapse: collapse;
    }
    th, td {
      padding: 12px 15px;
      border: 1px solid #ccc;
      text-align: center;
    }
    th {
      background-color: #005792;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #e9f1f7;
    }
    input {
      width: 100%;
      padding: 5px;
      text-align: center;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <h1>Editable Cricket League Points Table</h1>
  <table>
    <thead>
      <tr>
        <th>Team</th>
        <th>P</th>
        <th>W</th>
        <th>L</th>
        <th>NR</th>
        <th>Pts</th>
        <th>NRR</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><input type="text" value="Team A"></td>
        <td><input type="number" value="5" onchange="updateTable()"></td>
        <td><input type="number" value="4" onchange="updateTable()"></td>
        <td><input type="number" value="1" onchange="updateTable()"></td>
        <td><input type="number" value="0" onchange="updateTable()"></td>
        <td><input type="number" value="8" onchange="updateTable()"></td>
        <td><input type="text" value="+0.856" onchange="updateTable()"></td>
      </tr>
      <tr>
        <td><input type="text" value="Team B"></td>
        <td><input type="number" value="5" onchange="updateTable()"></td>
        <td><input type="number" value="3" onchange="updateTable()"></td>
        <td><input type="number" value="2" onchange="updateTable()"></td>
        <td><input type="number" value="0" onchange="updateTable()"></td>
        <td><input type="number" value="6" onchange="updateTable()"></td>
        <td><input type="text" value="+0.345" onchange="updateTable()"></td>
      </tr>
      <tr>
        <td><input type="text" value="Team C"></td>
        <td><input type="number" value="5" onchange="updateTable()"></td>
        <td><input type="number" value="2" onchange="updateTable()"></td>
        <td><input type="number" value="2" onchange="updateTable()"></td>
        <td><input type="number" value="1" onchange="updateTable()"></td>
        <td><input type="number" value="5" onchange="updateTable()"></td>
        <td><input type="text" value="-0.123" onchange="updateTable()"></td>
      </tr>
      <tr>
        <td><input type="text" value="Team D"></td>
        <td><input type="number" value="5" onchange="updateTable()"></td>
        <td><input type="number" value="1" onchange="updateTable()"></td>
        <td><input type="number" value="4" onchange="updateTable()"></td>
        <td><input type="number" value="0" onchange="updateTable()"></td>
        <td><input type="number" value="2" onchange="updateTable()"></td>
        <td><input type="text" value="-0.678" onchange="updateTable()"></td>
      </tr>
    </tbody>
  </table>

  <script>
    function updateTable() {
      let table = document.querySelector('table');
      let rows = table.querySelectorAll('tbody tr');
      
      rows.forEach((row) => {
        let inputs = row.querySelectorAll('input');
        
        let P = parseInt(inputs[1].value);
        let W = parseInt(inputs[2].value);
        let L = parseInt(inputs[3].value);
        let NR = parseInt(inputs[4].value);
        
        let Pts = W * 2 + NR; // Calculate Points: Wins * 2 + No Results
        inputs[5].value = Pts; // Update Points column
        
        // Example: Net Run Rate could be calculated differently based on real data
        let NRR = (W - L) / P; // A simplified version of NRR
        inputs[6].value = NRR.toFixed(3); // Update NRR column
      });
    }
  </script>
</body>
</html>
